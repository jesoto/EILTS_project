# Copia este archivo como `.env` (está en .gitignore: NUNCA lo subas a GitHub) y rellena tu clave.

# Obligatoria: clave de la API de OpenAI (https://platform.openai.com/api-keys).
# Se usa para evaluar Writing y Speaking, generar ejercicios y (en la nube) transcribir tu voz.
OPENAI_API_KEY=sk-...

# --- Opcional ---
# Tu zona horaria (por defecto la del sistema):
# IELTS_TZ=America/Lima
# Fecha de tu examen (el plan de 11 semanas se calcula desde aquí; por defecto 2026-12-29):
# IELTS_EXAM_DATE=2026-12-29
# Modelo de OpenAI (por defecto gpt-4.1-mini, ~0,002 USD por evaluación de Writing):
# IELTS_OPENAI_MODEL=gpt-4.1-mini
# Usar un modelo local gratis con Ollama en vez de OpenAI:
# IELTS_LLM_PROVIDER=ollama
