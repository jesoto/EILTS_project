# Secrets para el despliegue en Streamlit Community Cloud.
# Pega este contenido (con tus valores) en: tu app → Settings → Secrets.
# Para probar en local copia el archivo como `.streamlit/secrets.toml` (ya está en .gitignore). NUNCA lo subas a GitHub.

IELTS_MODE = "cloud"
IELTS_TZ = "America/Lima"
# IELTS_EXAM_DATE = "2026-12-29"

# Tu clave de OpenAI (la app es privada: solo entran los correos de ALLOWED_EMAILS).
OPENAI_API_KEY = "sk-..."

# Correos que pueden entrar, separados por comas. Si falta, nadie entra.
ALLOWED_EMAILS = "tu-correo@gmail.com"

# Bucket PRIVADO de Google Cloud Storage con tus tests extraídos, audios, grabaciones y la base de datos.
GCS_BUCKET = "nombre-de-tu-bucket"

# Login con Google (OIDC). Crea un «ID de cliente de OAuth» tipo «Aplicación web» en Google Cloud Console →
# APIs y servicios → Credenciales, y añade como URI de redirección autorizada exactamente el redirect_uri de abajo.
[auth]
redirect_uri = "https://TU-APP.streamlit.app/oauth2callback"
cookie_secret = "cambia-esto-por-una-cadena-larga-y-aleatoria"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Cuenta de servicio con acceso SOLO a ese bucket (rol «Storage Object Admin» sobre el bucket).
# Copia aquí los campos de su clave JSON.
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "ielts-app@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
